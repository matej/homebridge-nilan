{
  "displayName": "Homebridge Nilan",
  "name": "homebridge-nilan",
  "version": "1.0.1",
  "description": "Homebridge plugin for Nilan Compact P.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/matej/homebridge-nilan#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/matej/homebridge-nilan.git"
  },
  "bugs": {
    "url": "https://github.com/matej/homebridge-nilan/issues"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "config.schema.json",
    "dist",
    "resources"
  ],
  "scripts": {
    "check": "npm run lint && npm run build && npm test",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "dependencies": {
    "deep-equal": "^2.2.3",
    "modbus-serial": "^8.0.25",
    "throttle-debounce": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/deep-equal": "^1.0.4",
    "@types/node": "^22.20.1",
    "@types/throttle-debounce": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "homebridge": "^2.3.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.9.8"
}
